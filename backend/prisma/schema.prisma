generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  criadoEm  DateTime @default(now())

  chamados  Chamado[]
  conversas Conversa[]
}

model Chamado {
  id                String   @id @default(cuid())
  numero            String   @unique
  titulo            String
  descricao         String
  tipo              String
  categoria         String
  prioridade        String
  status            String
  afetados          String
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
  resolvidoEm       DateTime?

  usuarioId         String
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model Conversa {
  id           String   @id @default(cuid())
  status       String   @default("COM_AGENTE")
  resumo       String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  mensagens    Mensagem[]

  @@index([usuarioId])
}

model Mensagem {
  id         String   @id @default(cuid())
  autor      String
  texto      String
  criadoEm   DateTime @default(now())

  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id])

  @@index([conversaId])
}