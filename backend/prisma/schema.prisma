generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  criadoEm  DateTime @default(now())
  

  chamados  Chamado[]
  conversas    Conversa[] @relation("ConversasFuncionario")
  atendimentos Conversa[] @relation("ConversasAnalista")

  papel String @default("FUNCIONARIO")
}

model Chamado {
  id                String   @id @default(cuid())
  numero            String   @unique
  titulo            String
  descricao         String
  tipo              String
  categoria         String
  prioridade        String
  status            String
  afetados          String
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
  resolvidoEm       DateTime?

  usuarioId         String
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])

  origemRascunhoId String? @unique
  confirmacoes ConfirmacaoRascunho[]

  @@index([usuarioId])
}

model Conversa {
  id           String   @id @default(cuid())
  status       String   @default("COM_AGENTE")
  resumo       String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId    String
  usuario Usuario @relation("ConversasFuncionario", fields: [usuarioId], references: [id])
  analistaId String?
  analista   Usuario? @relation("ConversasAnalista", fields: [analistaId], references: [id])
  mensagens    Mensagem[]

  rascunho RascunhoChamado?

  @@index([usuarioId])
}

model Mensagem {
  id            String   @id @default(cuid())
  autor         String
  texto         String
  criadoEm      DateTime @default(now())

  entendimento  String?
  justificativa String?
  seguranca     String?

  conversaId    String
  conversa      Conversa @relation(fields: [conversaId], references: [id])

  acoes         AcaoAgente[]

  @@index([conversaId])
}
model Artigo {
  id       String @id @default(cuid())
  titulo   String @unique
  conteudo String
}

model AcaoAgente {
  id         String   @id @default(cuid())
  nome       String
  entrada    String
  resultado  String
  criadoEm   DateTime @default(now())

  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id])

  @@index([mensagemId])
}

model RascunhoChamado {
  id           String   @id @default(cuid())
  titulo       String
  descricao    String
  tipo         String
  categoria    String
  prioridade   String
  afetados     String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  conversaId   String   @unique
  conversa     Conversa @relation(fields: [conversaId], references: [id])
}

model ConfirmacaoRascunho {
  id         String   @id @default(cuid())
  rascunhoId String   @unique
  conversaId String
  acao       String
  criadoEm   DateTime @default(now())

  chamadoId  String
  chamado    Chamado  @relation(fields: [chamadoId], references: [id])

  @@index([conversaId])
}